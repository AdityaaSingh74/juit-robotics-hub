# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Development/Mock Mode
# Set to 'true' to use mock Supabase for development
VITE_USE_MOCK=false

# Backend API URL
# Local development
VITE_BACKEND_URL=http://localhost:3001

# Production - Set this when deploying to Vercel
# VITE_BACKEND_URL=https://your-go-backend.railway.app
